# ─── Microsoft Foundry (model backend for the agents) ───────────────────────
# From the Foundry portal: your project endpoint + a chat model deployment (gpt-4o).
AZURE_AI_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
AZURE_AI_MODEL_DEPLOYMENT=gpt-4o

# ─── Foundry IQ (grounding layer — Azure AI Search knowledge base) ──────────
# Search service that backs your Foundry IQ knowledge base.
SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
# Query key for the knowledge base MCP endpoint (read-only query key, NOT admin).
SEARCH_QUERY_KEY=<your-search-query-key>
# Admin key — only used by scripts/seed_foundry_iq.py to create the index + KB.
SEARCH_ADMIN_KEY=<your-search-admin-key>

# Knowledge base names created by the seed script.
KB_CURRICULUM=jss1-basic-science-kb
KB_WORLD=lumenor-lore-kb

# Embedding + chat deployments used for indexing/agentic retrieval (from iq-series infra).
AOAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com
AOAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AOAI_GPT_DEPLOYMENT=gpt-4o-mini

# ─── Game config ────────────────────────────────────────────────────────────
SUBJECT=Basic Science
GRADE=JSS1
